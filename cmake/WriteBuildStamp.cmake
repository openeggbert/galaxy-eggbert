# Script mode (cmake -DOUT=<file> -P WriteBuildStamp.cmake): writes the source that tells the game
# when it was built, "YYYY-MM-DD HH:MM" in the build machine's local time (SOURCE_DATE_EPOCH, when
# set, wins, as string(TIMESTAMP) honours it). The custom command of cmake/BuildStamp.cmake runs it
# only when something the game is linked from changed.
if(NOT OUT)
    message(FATAL_ERROR "WriteBuildStamp.cmake: pass -DOUT=<file>")
endif()
string(TIMESTAMP _ge_build_stamp "%Y-%m-%d %H:%M")
file(WRITE "${OUT}"
"// Generated by cmake/WriteBuildStamp.cmake: when this build was made. Do not edit.
#include \"GalaxyEggbertCNA/BuildStamp.hpp\"

namespace GalaxyEggbert::CNA
{
    const char* BuildStampText() noexcept
    {
        return \"${_ge_build_stamp}\";
    }
}
")
