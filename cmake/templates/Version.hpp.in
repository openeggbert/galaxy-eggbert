#pragma once

#include <string_view>

/**
 * @file GalaxyEggbert/Version.hpp
 * @brief The Galaxy Eggbert version this build is.
 *
 * Generated by the root CMakeLists.txt from cmake/templates/Version.hpp.in. The version is decided
 * in one place only, VERSION.txt (see docs/releasing.md); never edit the generated copy in the
 * build tree. The build's date and time are not here, they change with every build: see
 * src/GalaxyEggbertCNA/BuildStamp.hpp.
 */

/** @brief Major component of the version, as a preprocessor-testable integer literal. */
#define GALAXY_EGGBERT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@

/** @brief Minor component of the version, as a preprocessor-testable integer literal. */
#define GALAXY_EGGBERT_VERSION_MINOR @PROJECT_VERSION_MINOR@

/** @brief Patch component of the version, as a preprocessor-testable integer literal. */
#define GALAXY_EGGBERT_VERSION_PATCH @PROJECT_VERSION_PATCH@

/** @brief Pre-release identifier without its leading '-' ("rc.1"); empty on a final version. */
#define GALAXY_EGGBERT_VERSION_PRERELEASE "@GALAXY_EGGBERT_VERSION_PRERELEASE@"

/** @brief The complete version, e.g. "0.1.0" or "0.1.0-rc.1"; no leading 'v'. */
#define GALAXY_EGGBERT_VERSION_STRING "@GALAXY_EGGBERT_VERSION_STRING@"

namespace GalaxyEggbert
{
    [[nodiscard]] constexpr int VersionMajor() noexcept { return GALAXY_EGGBERT_VERSION_MAJOR; }
    [[nodiscard]] constexpr int VersionMinor() noexcept { return GALAXY_EGGBERT_VERSION_MINOR; }
    [[nodiscard]] constexpr int VersionPatch() noexcept { return GALAXY_EGGBERT_VERSION_PATCH; }

    /** @brief The pre-release identifier ("rc.1" of 0.1.0-rc.1), empty on a final version. */
    [[nodiscard]] constexpr std::string_view VersionPreRelease() noexcept
    {
        return GALAXY_EGGBERT_VERSION_PRERELEASE;
    }

    /** @brief The complete version in Semantic Versioning spelling, e.g. "0.1.0". */
    [[nodiscard]] constexpr std::string_view VersionString() noexcept
    {
        return GALAXY_EGGBERT_VERSION_STRING;
    }

    /** @brief Whether this is a pre-release (alpha, beta or release candidate). */
    [[nodiscard]] constexpr bool IsPreReleaseVersion() noexcept { return !VersionPreRelease().empty(); }
}
